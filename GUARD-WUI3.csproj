<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GuardWui3</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- The SHIPPING build is NativeAOT: publish-release.cmd (-p:PublishAot=true)
         stages the publish folder into GUARD\ and zips it. Dev/default builds stay
         JIT (debuggable, no C++ toolchain); this ReadyToRun setting only applies to
         a plain non-AOT `dotnet publish` (the R2R fallback) and is ignored under
         AOT. AOT was historically blocked by a startup fail-fast (0xc000027b) when
         a data-templated list bound its ItemsSource; the real cause was CsWinRT not
         emitting the generic-collection marshalling stubs (see AllowUnsafeBlocks
         below) plus the bound INotifyPropertyChanged models not being `partial`.
         With both fixed, AOT launches and renders all lists on WASDK 2.2.0 + .NET 10.
         (The earlier dotnet/runtime#115881 note was a red herring: that was a .NET 10
         *preview* interop regression, since fixed, not AOT-specific.) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required for NativeAOT: CsWinRT generates `unsafe` marshalling stubs for
         generic WinRT collection interfaces (e.g. ObservableCollection<FolderPair>
         crossing the ABI as ItemsControl.ItemsSource). Without this the stubs are
         not emitted and set_ItemsSource fails at runtime with
         "Value does not fall within the expected range" (E_INVALIDARG)
         (CsWinRT1030). Harmless for the ReadyToRun build. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GUARD</AssemblyName>
    <!-- The shipped single-file GUARD.exe and the staged release folder/zip live
         in the project root; keep the SDK from globbing them as project items.
         (GUARD.exe collides with publish output; GUARD\ and GUARD.zip would
         otherwise be bundled as content into the single-file publish, inflating
         it recursively on every rebuild.) The root-level build scripts
         (publish-*.cmd) are also globbed as default None items and bundled into
         the single-file exe (extracted to the runtime self-extraction cache);
         they have no business inside the shipped app, so exclude them too.
         The repo doc/metadata files (README.md, CHANGELOG.md, CLAUDE.md, LICENSE,
         .gitignore) are likewise globbed as default None items and bundled into
         the exe; none are build inputs, so exclude them as well. (README.md is
         still shipped: publish-singlefile.cmd copies it into the staged GUARD\
         folder for the offline Help button - that copy is independent of this.)
         The .xaml source and app.manifest also leak into the bundle but are real
         build inputs (Page/ApplicationDefinition and the ApplicationManifest), so
         they are NOT excluded here - excluding *.xaml would also drop it from the
         WinUI Page glob (which honors DefaultItemExcludes) and break the build.
         Their redundant loose copy is instead stripped from the publish/bundle
         output in TrimGuardPublishPayload below. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);GUARD.exe;GUARD.zip;SHA256SUMS;GUARD\**;*.cmd;*.md;LICENSE;.gitignore</DefaultItemExcludes>
    <!-- Versioning is driven by MinVer from git tags (releases are tagged vX.Y.Z),
         so the version is never hand-edited; do not add a <Version> property here,
         it would override MinVer's computed value. Untagged commits get the next
         minor (not patch) pre-release: between releases main carries new features,
         and 0.x minors are where behavior changes land per the repo's SemVer use. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <!-- Build-time only: computes the version during build, ships nothing. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Trim the publish output of payload GUARD never uses, cutting both on-disk
       size and (more visibly, for a portable app) the number of loose files and
       folders shown next to GUARD.exe. Three groups go:

       1. The Windows Copilot Runtime / Windows AI Foundation stack that Windows
          App SDK drags in (LanguageModel/Phi Silica, content safety/moderation,
          imaging + image creation, vision, semantic search, Windows ML, and the
          NPU workload manifests). GUARD calls none of these. This is both the
          heavy native binaries (onnxruntime/DirectML/Tensors, NPUDetect,
          PerceptiveStreaming) and their many .winmd / *.Projection.dll companions
          and workloads*.json manifests, matched by feature substring in the
          target below.
       2. The managed-debugger / crash-dump diagnostics (mscordbi, the versioned
          mscordaccore[_ver], DiaSymReader, createdump) a shipped portable build
          never needs.
       3. The WinUI framework's localized resource folders (the ~80 per-culture
          *.dll.mui). GUARD ships English-only (it has no x:Uid/.resw localization
          of its own), so these localize only built-in WinUI control strings; the
          English cultures are kept and every other culture falls back to the
          embedded English. This alone collapses ~80 of the folder's directories.

       Reversible: delete this target (or a single clause) and the files return on
       the next publish. If a future feature needs the AI APIs, drop the matching
       clause and the App SDK repackages them; to localize GUARD into a language,
       keep that culture's .mui (clause 3). -->
  <!-- Semicolon-delimited exact filenames (leading+trailing ';' so Contains()
       matches a whole name). Substring-matched families (the AI stack, the
       versioned DAC) are handled by the target's conditions, not listed here. -->
  <PropertyGroup>
    <GuardExcludedFiles>;onnxruntime.dll;DirectML.dll;Microsoft.ML.OnnxRuntime.dll;onnxruntime_providers_shared.dll;System.Numerics.Tensors.dll;NPUDetect.dll;PerceptiveStreaming.dll;mscordbi.dll;mscordaccore.dll;Microsoft.DiaSymReader.Native.amd64.dll;createdump.exe;</GuardExcludedFiles>
  </PropertyGroup>

  <Target Name="TrimGuardPublishPayload"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_ComputeFilesToBundle;GenerateSingleFileBundle">
    <ItemGroup>
      <!-- Drop from the folder-publish set and the single-file bundle set alike. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$(GuardExcludedFiles.Contains(';%(Filename)%(Extension);'))
                or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore_'))" />
      <FilesToBundle Remove="@(FilesToBundle)"
        Condition="$(GuardExcludedFiles.Contains(';%(Filename)%(Extension);'))
                or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore_'))" />

      <!-- The rest of the Windows AI / Copilot Runtime stack: the .winmd metadata,
           CsWinRT *.Projection.dll, and workloads*.json manifests that accompany
           the native AI binaries listed above. Matched by feature substring in the
           filename: "Microsoft.Windows.AI" prefix plus ".AI." catch the AI
           namespace and its Internal.AI variants; the rest catch the imaging,
           image-creation, vision, semantic-search and workload families. None of
           these substrings collide with a file GUARD needs (Storage, windowing,
           notifications, etc. keep their own .winmd). -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI'))
                or $([System.String]::Copy('%(Filename)').Contains('.AI.'))
                or $([System.String]::Copy('%(Filename)').Contains('Imaging'))
                or $([System.String]::Copy('%(Filename)').Contains('ImageCreation'))
                or $([System.String]::Copy('%(Filename)').Contains('Vision'))
                or $([System.String]::Copy('%(Filename)').Contains('SemanticSearch'))
                or $([System.String]::Copy('%(Filename)').Contains('Workloads'))
                or $([System.String]::Copy('%(Filename)').StartsWith('workloads'))" />
      <FilesToBundle Remove="@(FilesToBundle)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI'))
                or $([System.String]::Copy('%(Filename)').Contains('.AI.'))
                or $([System.String]::Copy('%(Filename)').Contains('Imaging'))
                or $([System.String]::Copy('%(Filename)').Contains('ImageCreation'))
                or $([System.String]::Copy('%(Filename)').Contains('Vision'))
                or $([System.String]::Copy('%(Filename)').Contains('SemanticSearch'))
                or $([System.String]::Copy('%(Filename)').Contains('Workloads'))
                or $([System.String]::Copy('%(Filename)').StartsWith('workloads'))" />

      <!-- Drop the WinUI framework's localized resource folders: every per-culture
           *.dll.mui except the English ones. GUARD ships English-only, so these
           localize only built-in WinUI control strings, which fall back to the
           embedded English when absent. The culture is the file's publish
           subfolder; check both RelativePath and DestinationSubDirectory so the
           match holds regardless of which the SDK populates (the English cultures
           - en-US, en-GB - start with 'en' in whichever one carries the path). -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.mui'
                and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('en'))
                and !$([System.String]::Copy('%(ResolvedFileToPublish.DestinationSubDirectory)').StartsWith('en'))" />

      <!-- Drop our own loose source build inputs (the .xaml files and app.manifest)
           from the shipped output. The .xaml compile to XBF embedded in GUARD.pri
           and app.manifest is embedded into the exe as a Win32 resource, so the
           loose source copies are dead weight at runtime; left in, the SDK globs
           them as default None items and single-file publish bundles them into the
           self-extraction cache. Removing them here strips only the redundant
           shipped copy, never the Page/ApplicationDefinition/ApplicationManifest
           build inputs, so compilation is unaffected. (No runtime payload ships a
           loose .xaml or app.manifest, so matching by extension/name is safe.) -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.xaml' or '%(Filename)%(Extension)' == 'app.manifest'" />
      <FilesToBundle Remove="@(FilesToBundle)"
        Condition="'%(Extension)' == '.xaml' or '%(Filename)%(Extension)' == 'app.manifest'" />
    </ItemGroup>
  </Target>

</Project>
