<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.AppSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    Title="Export App Settings"
    PrimaryButtonText="Copy Selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- The default ContentDialog width clips the three-column list; widen it. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="620" Spacing="8">
        <TextBlock TextWrapping="Wrap"
                   Text="GUARD matched the ticked apps' names and publishers against folder names under %APPDATA%, %LOCALAPPDATA% and %USERPROFILE%\.config. This matching is a best guess, so review the list and untick anything that looks wrong. Sizes are measured quickly; larger folders may show a minimum." />

        <Grid Margin="32,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Settings folder" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Matched app" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Border BorderThickness="1" MaxHeight="240" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Candidates}"
                              AutomationProperties.Name="Settings folders to copy"
                              TabFocusNavigation="Once"
                              XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AppSettingsCandidate">
                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind Caption}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayPath}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind MatchedAppsLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Selected folders are copied to AppSettings under your list destination, sorted by where they came from, with a manifest and restore instructions. Not included: settings stored in the Windows registry, per-machine data in ProgramData, and Microsoft Store packaged app state (%LOCALAPPDATA%\Packages). Cache subfolders are skipped during the copy." />
    </StackPanel>
</ContentDialog>
