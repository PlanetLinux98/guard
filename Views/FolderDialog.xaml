<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.FolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Folder"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary">

    <StackPanel Width="440" Spacing="8">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSource" Grid.Column="0" Header="Source folder:" AccessKey="S"
                     AutomationProperties.Name="Source folder path" />
            <Button Grid.Column="1" Content="Browse..." AccessKey="B" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Browse for source folder" Click="OnBrowse" />
        </Grid>
        <!-- The helper text is attached to the field as UIA HelpText so a screen
             reader speaks it when focus lands here (where it is useful), plus a
             visible wrapping caption below for sighted users. The caption is
             AccessibilityView=Raw so it is not read again as an orphan paragraph
             out of context when the dialog first opens. -->
        <TextBox x:Name="TxtSub" Header="Destination subfolder:" AccessKey="U"
                 AutomationProperties.Name="Destination subfolder name"
                 AutomationProperties.HelpText="The folder name created under the backup destination root, where this source's files are copied." />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   AutomationProperties.AccessibilityView="Raw"
                   Text="The folder name created under the backup destination root, where this source's files are copied." />
    </StackPanel>
</ContentDialog>
