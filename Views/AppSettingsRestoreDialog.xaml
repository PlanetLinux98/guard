<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.AppSettingsRestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    Title="Reinstall and Restore App Settings"
    PrimaryButtonText="Reinstall &amp; Restore"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- The default ContentDialog width clips the three-column list; widen it. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="620" Spacing="8">
        <!-- Operation summary; set from code so it can name the install count and
             the rename-aside reassurance for whichever path opened the dialog. -->
        <TextBlock TextWrapping="Wrap" Text="{x:Bind HeaderText}" />

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Select All" AccessKey="L"
                    ToolTipService.ToolTip="Tick all settings folders"
                    Click="OnSelectAll" />
            <Button Content="Select None" AccessKey="O"
                    ToolTipService.ToolTip="Untick all settings folders"
                    Click="OnSelectNone" />
        </StackPanel>

        <Grid Margin="32,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Settings folder" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Border BorderThickness="1" MaxHeight="240" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CandidateList" ItemsSource="{x:Bind Candidates}"
                              AutomationProperties.Name="Settings folders to restore"
                              TabFocusNavigation="Once"
                              XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AppSettingsRestoreCandidate">
                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind Caption}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayPath}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind StatusLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Each ticked folder is copied back to the location shown, re-anchored to your current user profile. A folder marked &quot;Replaces existing&quot; is renamed aside (.guard-old-) before it is replaced, so nothing is lost. Files that are locked because their app is running are skipped and counted." />
    </StackPanel>
</ContentDialog>
