<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.RestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    Title="Restore Files"
    PrimaryButtonText="Restore"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary">

    <!-- The default ContentDialog width clips the two-column list; widen it,
         as the app-settings restore dialog does. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="660" Spacing="10">
        <TextBlock TextWrapping="Wrap" Text="{x:Bind HeaderText}" />

        <!-- Shown only when the destination holds more than one backup (dated
             version folders, or a mix of those and an older single copy). -->
        <StackPanel x:Name="SnapshotRow" Orientation="Horizontal" Spacing="8"
                    Visibility="Collapsed">
            <TextBlock Text="Restore from:" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbSnapshot" MinWidth="280" AccessKey="F"
                      AutomationProperties.Name="Backup to restore from"
                      SelectionChanged="OnSnapshotChanged" />
        </StackPanel>

        <Grid Margin="32,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Folder in the backup" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Restore into" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <!-- Checkbox rows in an ItemsControl, not a ListView: each row's own
             ticked state is what matters, and a ListViewItem would add a second
             focus layer that swallows it (see the folder list on the main page). -->
        <Border BorderThickness="1" MaxHeight="220" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemList" ItemsSource="{x:Bind Items}"
                              AutomationProperties.Name="Folders to restore"
                              TabFocusNavigation="Once"
                              XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RestoreItem">
                            <!-- OneWay, not the x:Bind default of OneTime: the
                                 restore location can be changed in place, and the
                                 visible row and its spoken name must follow. -->
                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind Caption, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind FolderName}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TargetDisplay, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Change Restore Location..." AccessKey="C"
                    ToolTipService.ToolTip="Choose a different folder for the row that last held focus"
                    Click="OnChangeTarget" />
            <Button Content="Select All" AccessKey="L"
                    ToolTipService.ToolTip="Tick every folder that has a restore location"
                    Click="OnSelectAll" />
            <Button Content="Select None" AccessKey="N"
                    ToolTipService.ToolTip="Untick all folders"
                    Click="OnSelectNone" />
        </StackPanel>

        <!-- Mode. RadioButtons (the container) gives arrow-key
             selection-follows-focus and a single tab stop, like the File Backup
             page's Mode group. The two-line content stops UIA deriving a name,
             so each radio carries the verbatim visible text as its Name. -->
        <RadioButtons AutomationProperties.Name="What to do with files already there">
            <RadioButton x:Name="RbAddUpdate" IsChecked="True" AccessKey="A"
                         AccessKeyInvoked="OnToggleAccessKeyInvoked"
                         AutomationProperties.Name="Put back what is missing. Restores files that are gone and updates ones the backup has a newer copy of. Anything you have changed since the backup is left alone, and nothing is deleted.">
                <StackPanel>
                    <TextBlock Text="Put back what is missing" />
                    <TextBlock Text="Restores files that are gone and updates ones the backup has a newer copy of. Anything you have changed since the backup is left alone, and nothing is deleted."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="RbReplace" AccessKey="R"
                         AccessKeyInvoked="OnToggleAccessKeyInvoked"
                         AutomationProperties.Name="Replace files with the backup copies. Overwrites files that are already there even if they are newer. Use this when a file has been damaged or encrypted. GUARD checks what would change and asks you first. Nothing is deleted.">
                <StackPanel>
                    <TextBlock Text="Replace files with the backup copies" />
                    <TextBlock Text="Overwrites files that are already there even if they are newer. Use this when a file has been damaged or encrypted. GUARD checks what would change and asks you first. Nothing is deleted."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </RadioButton>
        </RadioButtons>
    </StackPanel>
</ContentDialog>
