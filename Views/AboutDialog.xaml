<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About GUARD"
    CloseButtonText="Close"
    DefaultButton="Close">

    <StackPanel Width="380" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <!-- Decorative: the dialog title already names the app, so the
                 logo stays out of the accessibility tree. Source is set in
                 code-behind from the embedded resource. -->
            <Image x:Name="IconImage" Width="64" Height="64"
                   VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <StackPanel VerticalAlignment="Center">
                <!-- No AutomationProperties.Name: a TextBlock's accessible name
                     is its Text (the repo rule the release lint greps for). -->
                <TextBlock Text="GUARD" FontSize="26" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="A backup and app inventory utility for Windows." />
        <TextBlock Text="Created by PlanetLinux98." />
        <TextBlock Text="Released under the MIT License." Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Open Project Page" AccessKey="P"
                    ToolTipService.ToolTip="Open the GUARD project page in your browser"
                    Click="OnProjectPage" />
            <!-- Closes About and hands off to MainWindow (only one ContentDialog
                 may be open at a time, so the check's own dialogs need About gone). -->
            <Button Content="Check for Updates" AccessKey="U"
                    ToolTipService.ToolTip="Check GitHub for a newer GUARD release"
                    Click="OnCheckUpdates" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
