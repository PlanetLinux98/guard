<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.AppImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    Title="Reinstall from a saved list"
    PrimaryButtonText="Reinstall Selected"
    SecondaryButtonText="Reinstall &amp; Restore Settings"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- The default ContentDialog width clips the three-column list; widen it. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="620" Spacing="8">
        <!-- Set from code: count, source machine/date, and whether a settings
             bundle was found beside the list (which gates Reinstall & Restore). -->
        <TextBlock TextWrapping="Wrap" Text="{x:Bind HeaderText}" />

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Select All" AccessKey="L"
                    ToolTipService.ToolTip="Tick all apps"
                    Click="OnSelectAll" />
            <Button Content="Select None" AccessKey="O"
                    ToolTipService.ToolTip="Untick all apps"
                    Click="OnSelectNone" />
        </StackPanel>

        <Grid Margin="32,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Application" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Version" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Source" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Border BorderThickness="1" MaxHeight="260" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Apps}"
                              AutomationProperties.Name="Apps to reinstall"
                              TabFocusNavigation="Once"
                              XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AppEntry">
                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind Caption}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Version}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SourceLabel}"
                                               Margin="0,0,8,0" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Only &quot;Winget&quot; and &quot;Store&quot; apps reinstall automatically; &quot;Manual&quot; apps must be installed by hand. Reinstalling may require Administrator rights. Apps already on this PC are reinstalled to their latest version." />
    </StackPanel>
</ContentDialog>
