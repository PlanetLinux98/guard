<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GuardWui3.Views.SystemImageRestoreHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Restore this PC from a system image"
    CloseButtonText="Close"
    DefaultButton="Close"
    AutomationProperties.IsDialog="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
        <StackPanel Width="460" Spacing="8">
            <TextBlock TextWrapping="Wrap"
                       Text="A full restore replaces everything on the Windows drive, so it runs from outside Windows. You cannot restore the running PC from inside GUARD; you boot from Windows installation media and use its built-in System Image Recovery." />

            <TextBlock Text="Before you start" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap"
                       Text="1. Connect the disk that holds the image (or make sure the network share is reachable)." />
            <TextBlock TextWrapping="Wrap"
                       Text="2. Have bootable Windows installation media ready. Use Create Recovery Media on the System Image tab to build a USB, or any Windows installation USB or DVD of the same architecture." />

            <TextBlock Text="Restoring" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap"
                       Text="3. Insert the installation USB and start the PC from it (use the firmware boot menu, often F12, Esc, or F9 during startup)." />
            <TextBlock TextWrapping="Wrap"
                       Text="4. At the Windows Setup screen, choose your language, then click 'Repair your computer' (not Install)." />
            <TextBlock TextWrapping="Wrap"
                       Text="5. Go to Troubleshoot, then Advanced options, then System Image Recovery." />
            <TextBlock TextWrapping="Wrap"
                       Text="6. Choose the latest image (or 'Select a system image' to pick a specific one or a network location), then follow the prompts to restore." />
            <TextBlock TextWrapping="Wrap"
                       Text="7. When it finishes, remove the USB and restart. If the drive used BitLocker, turn it back on afterwards." />

            <TextBlock Text="Restoring from a network share" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap"
                       Text="The recovery environment cannot look up server names the way Windows does, so address the share by its IP address rather than its name, and have the share's username and password ready (it will ask for them). Enter the full path down to the folder that holds the image, the same folder you back up to here." />
            <TextBlock x:Name="NetworkPathText" TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.Name="Network path to enter when restoring" />

            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Note: restoring works best on the same or very similar hardware. On very different hardware Windows may not boot afterwards; in that case use the File Backup and App Management tabs to recover your files and apps onto a fresh install instead." />

            <Button Content="Open User Manual" AccessKey="M" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTipService.ToolTip="Open the full restore instructions in the user manual"
                    Click="OnOpenManual" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
