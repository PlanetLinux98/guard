<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GuardWui3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    Title="GUARD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Pivot x:Name="Tabs" Margin="4,4,4,8"
           AutomationProperties.Name="Backup sections"
           SelectionChanged="OnTabChanged">

        <!-- Help and About sit inline at the right end of the tab strip
             (RightHeader), so they read as part of the app chrome rather than
             floating alone, and stay visible above both tabs. -->
        <Pivot.RightHeader>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="BtnHelp" Content="Help" AccessKey="H"
                        Click="OnHelp" />
                <Button x:Name="BtnAbout" Content="About" AccessKey="A"
                        Click="OnAbout" />
            </StackPanel>
        </Pivot.RightHeader>

            <!-- ============================ FILE BACKUP ============================ -->
            <PivotItem Header="File Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="720" HorizontalAlignment="Left" Margin="14" Spacing="6">

                        <!-- Destination -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDest" Grid.Column="0" Header="Backup destination:"
                                     AccessKey="D"
                                     TextChanged="OnDirtyChanged" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button Content="Browse..." AccessKey="B"
                                        Click="OnBrowseDest" />
                                <Button Content="Test" AccessKey="T"
                                        ToolTipService.ToolTip="Test the backup destination"
                                        Click="OnTestDest" />
                            </StackPanel>
                        </Grid>

                        <!-- Folders -->
                        <TextBlock Text="Folders to back up (tick to include):" Margin="0,8,0,0" />
                        <Grid Margin="32,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Source folder" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Destination subfolder" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Border BorderThickness="1" Height="180" CornerRadius="4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FolderList" ItemsSource="{x:Bind Folders}"
                                              AutomationProperties.Name="Folders to back up"
                                              TabFocusNavigation="Once"
                                              XYFocusKeyboardNavigation="Enabled">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FolderPair">
                                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Bind Caption}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="360" />
                                                        <ColumnDefinition Width="200" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Source}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SubFolder}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="Add Folder..." AccessKey="F"
                                    Click="OnAddFolder" />
                            <Button Content="Remove Folder" AccessKey="R"
                                    Click="OnRemoveFolder" />
                        </StackPanel>

                        <!-- Mode. RadioButtons (the container) gives arrow-key
                             selection-follows-focus and a single tab stop, unlike
                             individual GroupName-tied RadioButtons. -->
                        <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <RadioButtons AutomationProperties.Name="Mode" Margin="0,0,0,12">
                            <RadioButtons.Resources>
                                <!-- The RadioButtons container reserves uniform row
                                     height + row spacing between items. Shrink the
                                     measured row height with MinHeight=0 and a slight
                                     negative vertical margin to close the gap. -->
                                <Style TargetType="RadioButton">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0,-10" />
                                </Style>
                            </RadioButtons.Resources>
                            <RadioButton x:Name="RbAdditive" IsChecked="True" AccessKey="I"
                                         Checked="OnDirtyChecked"
                                         Content="Additive  (copy new and changed files; nothing at the destination is ever deleted)" />
                            <RadioButton x:Name="RbMirror" AccessKey="M"
                                         Checked="OnDirtyChecked"
                                         Content="Mirror  (make the destination match the source exactly; files deleted from the source are also deleted at the destination)" />
                        </RadioButtons>

                        <!-- Excludes -->
                        <Grid Margin="0,8,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtExDirs" Grid.Column="0" Header="Exclude folder names (one per line):"
                                     AcceptsReturn="True" Height="80" TextWrapping="NoWrap"
                                     ToolTipService.ToolTip="One name or pattern per line. Wildcards work: * matches any text, ? matches one character (e.g. node_modules, temp*)."
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnDirtyChanged" />
                            <TextBox x:Name="TxtExFiles" Grid.Column="1" Header="Exclude file names (one per line):"
                                     AcceptsReturn="True" Height="80" TextWrapping="NoWrap"
                                     ToolTipService.ToolTip="One name or pattern per line. Wildcards work: * matches any text, ? matches one character (e.g. *.iso, *.tmp, ~$*)."
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnDirtyChanged" />
                        </Grid>

                        <!-- Schedule -->
                        <TextBlock Text="Schedule" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkSchedule" Content="Run daily at:" IsChecked="True" AccessKey="Y"
                                      VerticalAlignment="Center" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                            <TextBox x:Name="TxtTime" Width="64" VerticalAlignment="Center"
                                     AutomationProperties.Name="Daily run time, 24-hour HH colon mm"
                                     TextChanged="OnDirtyChanged" />
                            <Button Content="Create / Update Task" AccessKey="U"
                                    ToolTipService.ToolTip="Create or update the daily scheduled task"
                                    Click="OnCreateTask" />
                            <Button Content="Remove Task" AccessKey="K"
                                    ToolTipService.ToolTip="Remove the daily scheduled task"
                                    Click="OnRemoveTask" />
                        </StackPanel>
                        <TextBlock x:Name="LblNextRun" Text="Next run: (unknown)" Margin="0,4,0,0" />

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                            <Button Content="Save Settings" AccessKey="S" Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Save settings and regenerate the backup script and scheduled task"
                                    Click="OnSave" />
                            <Button Content="Run Now" AccessKey="N"
                                    ToolTipService.ToolTip="Run the backup now"
                                    Click="OnRunNow" />
                            <Button Content="Preview" AccessKey="P"
                                    ToolTipService.ToolTip="Preview the backup without making changes"
                                    Click="OnPreview" />
                            <Button Content="Open Last Log" AccessKey="L"
                                    ToolTipService.ToolTip="Open the last backup log"
                                    Click="OnOpenLog" />
                            <Button Content="Open Destination" AccessKey="O"
                                    ToolTipService.ToolTip="Open the backup destination folder"
                                    Click="OnOpenDest" />
                        </StackPanel>

                        <!-- Status line (live region) -->
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,8,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Settings status">
                            <Ellipse x:Name="ScriptDot" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="ScriptStatusText" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Settings status" />
                        </StackPanel>

                        <!-- Progress + output -->
                        <TextBlock x:Name="FileProgressLabel" Margin="0,8,0,2"
                                   AutomationProperties.Name="Backup progress" />
                        <ProgressBar x:Name="FileProgress" Minimum="0" Maximum="1" Value="0"
                                     AutomationProperties.Name="Backup progress bar" />
                        <TextBlock Text="Output:" Margin="0,8,0,2" />
                        <TextBox x:Name="TxtOutput" Height="150" IsReadOnly="True" IsSpellCheckEnabled="False"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Backup output" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ============================ APP INVENTORY ============================ -->
            <PivotItem Header="App Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="720" HorizontalAlignment="Left" Margin="14" Spacing="6">

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Installed apps are read from the Windows uninstall registry, and cross-checked against winget when it is available. Apps winget can reinstall are marked &quot;Winget&quot;; the rest are marked &quot;Manual&quot;. Tick the apps you want to keep, then Export the list to your chosen destination. After an OS reinstall, Import the list and Reinstall Selected to put the Winget ones back automatically. The exported file is plain JSON, so you can also open it to read your app list by hand." />

                        <!-- Export destination -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAppDest" Grid.Column="0" Header="List destination:" AccessKey="D" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button Content="Browse..." AccessKey="B"
                                        Click="OnBrowseApp" />
                                <Button Content="Test" AccessKey="T"
                                        ToolTipService.ToolTip="Test the app list destination"
                                        Click="OnTestApp" />
                            </StackPanel>
                        </Grid>

                        <!-- Toolbar -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Button x:Name="BtnAppRefresh" Content="Refresh List" AccessKey="R"
                                    ToolTipService.ToolTip="Rescan installed apps"
                                    Click="OnRefreshApps" />
                            <Button x:Name="BtnAppAll" Content="Select All" AccessKey="L"
                                    ToolTipService.ToolTip="Tick all visible apps"
                                    Click="OnSelectAll" />
                            <Button x:Name="BtnAppNone" Content="Select None" AccessKey="O"
                                    ToolTipService.ToolTip="Untick all visible apps"
                                    Click="OnSelectNone" />
                            <TextBox x:Name="TxtAppFilter" Width="180" Header="Filter:" AccessKey="F" VerticalAlignment="Center"
                                     TextChanged="OnFilterChanged" />
                        </StackPanel>

                        <!-- App list -->
                        <Grid Margin="32,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Application" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Version" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Source" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Border BorderThickness="1" Height="260" CornerRadius="4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AppListControl" ItemsSource="{x:Bind AppRows}"
                                              AutomationProperties.Name="Installed applications"
                                              TabFocusNavigation="Once"
                                              XYFocusKeyboardNavigation="Enabled">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppEntry">
                                            <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                                      IsChecked="{x:Bind Include, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Bind Caption}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Version}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SourceLabel}"
                                                               Margin="0,0,8,0" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="AppStatus" Text="Open this tab to scan installed apps." Margin="0,4,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Inventory status" />

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button x:Name="BtnAppExport" Content="Export List" AccessKey="E"
                                    ToolTipService.ToolTip="Export the ticked apps to the destination"
                                    Click="OnExportApps" />
                            <Button x:Name="BtnAppImport" Content="Import List" AccessKey="I"
                                    ToolTipService.ToolTip="Import an app list from a file"
                                    Click="OnImportApps" />
                            <Button x:Name="BtnAppReinstall" Content="Reinstall Selected" AccessKey="S"
                                    ToolTipService.ToolTip="Reinstall the ticked Winget apps"
                                    Click="OnReinstall" />
                            <Button Content="Open Folder" AccessKey="P"
                                    ToolTipService.ToolTip="Open the app list destination folder"
                                    Click="OnOpenAppDest" />
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,4"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Note: Reinstalling may require Administrator rights. If installs fail with an access error, restart GUARD as Administrator. Portable apps (run from a folder, no installer) are not auto-detected." />

                        <!-- Progress + output -->
                        <TextBlock x:Name="AppProgressLabel" Margin="0,8,0,2"
                                   AutomationProperties.Name="Reinstall progress" />
                        <ProgressBar x:Name="AppProgress" Minimum="0" Maximum="1" Value="0"
                                     AutomationProperties.Name="Reinstall progress bar" />
                        <TextBlock Text="Output:" Margin="0,8,0,2" />
                        <TextBox x:Name="TxtAppOutput" Height="120" IsReadOnly="True" IsSpellCheckEnabled="False"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Inventory output" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
    </Pivot>
</Window>
