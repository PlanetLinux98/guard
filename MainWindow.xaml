<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GuardWui3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GuardWui3.Models"
    xmlns:views="using:GuardWui3.Views"
    Title="GUARD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Two rows: the NavigationView fills the window; a persistent status bar
         sits below it, outside both pages' ScrollViewers so it is always
         visible. -->
    <Grid>
        <Grid.Resources>
            <!-- Settings-app card: groups a related cluster of controls so the
                 page reads as scannable blocks rather than one flat wall. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="ColumnHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window-wide page jumps: Ctrl+1 File Backup, Ctrl+2 System Image,
             Ctrl+3 App Management, Ctrl+4 Settings. On the root Grid so they
             fire from anywhere; one handler maps the key to the nav item. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnPageAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnPageAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnPageAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnPageAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Left navigation replaces the old Pivot: it reclaims the oversized tab
             header strip, keeps the two sections one keystroke apart, and puts
             Help / About in the footer as invoke-only items (SelectsOnInvoked is
             false, so they act as buttons and never become a selected page). -->
        <NavigationView x:Name="Nav" Grid.Row="0"
                        PaneDisplayMode="Auto"
                        PaneTitle="GUARD"
                        OpenPaneLength="210"
                        CompactModeThresholdWidth="500"
                        ExpandedModeThresholdWidth="980"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked"><!--
             PaneDisplayMode=Auto: the pane is expanded (full labels) at normal/wide
             widths and collapses to the compact icon rail once narrower than
             ExpandedModeThresholdWidth (980), reclaiming ~160 DIP so the bottom
             action bar and App Management toolbar still fit down to the 860 DIP
             minimum. The toggle button lets the rail expand on demand;
             CompactModeThresholdWidth is kept low (500) so it stays a rail rather
             than dropping to the hidden "minimal" mode in range.

             The earlier gap-on-left/clip-on-right glitch on the Expanded<->Compact
             transition came from the old Stretch+MaxWidth content centring colliding
             with the inset recompute (and from hiding the toggle while still allowing
             collapse). With content now filling the width responsively and the toggle
             present, the transition is clean both ways. -->
            <NavigationView.MenuItems>
                <!-- Each page's Content hosts its label plus a small ProgressRing
                     (ApplyPageProgress) so a running job on the page stays visible (and
                     screen-reader discoverable) from any page: the ring fills as a
                     determinate arc once a percentage is known and spins while a phase
                     has none. The status-bar progress now tracks only the focused page,
                     so the ring is what surfaces a job owned by another page. A
                     NavigationViewItem only auto-derives its UIA name from a *string*
                     Content; once Content is a panel that derivation is lost and the
                     item reads nameless, so each carries an explicit
                     AutomationProperties.Name equal to its visible label (WCAG 2.5.3).
                     The label TextBlock and the ring are AccessibilityView=Raw so the
                     subtree adds no duplicate/noise nodes, and "running" is exposed via
                     HelpText only while busy (read after the name on focus). Note: in
                     the compact icon rail (narrower than ExpandedModeThresholdWidth) the
                     label and ring are hidden; SR users still get the name, the HelpText
                     and the existing finish notification. -->
                <NavigationViewItem x:Name="NavFile" Tag="file" IsSelected="True"
                                    AutomationProperties.Name="File Backup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="File Backup" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <ProgressRing x:Name="NavFileRing" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavImage" Tag="image"
                                    AutomationProperties.Name="System Image">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="System Image" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <ProgressRing x:Name="NavImageRing" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavApps" Tag="apps"
                                    AutomationProperties.Name="App Management">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="App Management" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <ProgressRing x:Name="NavAppsRing" Width="16" Height="16"
                                      IsActive="False" Visibility="Collapsed"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- Help keeps the conventional F1 accelerator. -->
                <NavigationViewItem x:Name="NavHelp" Content="Help" Tag="help" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="About" Tag="about" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Both pages live here, toggled by selection (see
                 OnNavSelectionChanged); a single MainWindow keeps every named
                 control and binding in one place. -->
            <Grid>
                <!-- ============================ FILE BACKUP ============================ -->
                <Grid x:Name="FileBackupPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- Content fills the window width (no max-width cap): cards and
                             lists stretch, so widening reveals more of long paths and the
                             app columns rather than empty space. The list grids use a star
                             primary column for this. -->
                        <StackPanel HorizontalAlignment="Stretch" Margin="16" Spacing="12">

                            <!-- Destination -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Backup destination" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtDest" Grid.Column="0"
                                                 AutomationProperties.Name="Backup destination"
                                                 PlaceholderText="Choose where backups are written..."
                                                 AccessKey="D"
                                                 TextChanged="OnDirtyChanged" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Bottom" Margin="8,0,0,0">
                                            <Button Content="Browse..." AccessKey="B"
                                                    Click="OnBrowseDest" />
                                            <Button Content="Test"
                                                    ToolTipService.ToolTip="Test the backup destination"
                                                    Click="OnTestDest" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Folders -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Folders to back up (tick to include)" Style="{StaticResource CardTitle}" />
                                    <!-- Source folder is a star column so it grows with the
                                         window; the subfolder stays a fixed 200. The header
                                         and row grids share these widths so the columns line
                                         up (the 32 left margin clears the row checkboxes). -->
                                    <Grid Margin="32,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="760" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Source folder" Style="{StaticResource ColumnHeader}" />
                                        <TextBlock Grid.Column="1" Text="Destination subfolder" Style="{StaticResource ColumnHeader}" />
                                    </Grid>
                                    <Border BorderThickness="1" Height="180" CornerRadius="4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="FolderList" ItemsSource="{x:Bind Folders}"
                                                          AutomationProperties.Name="Folders to back up"
                                                          TabFocusNavigation="Once"
                                                          XYFocusKeyboardNavigation="Enabled">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FolderPair">
                                                        <!-- OneWay (x:Bind defaults to OneTime) so an Edit Folder
                                                             change to an existing pair refreshes the visible row
                                                             and its spoken name in place. -->
                                                        <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  IsChecked="{x:Bind Include, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind Caption, Mode=OneWay}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MaxWidth="760" />
                                                                    <ColumnDefinition Width="200" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind DisplaySource, Mode=OneWay}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind SubFolder, Mode=OneWay}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add Folder..." AccessKey="A"
                                                Click="OnAddFolder" />
                                        <Button Content="Edit Folder..." AccessKey="E"
                                                ToolTipService.ToolTip="Edit the folder row that last held focus"
                                                Click="OnEditFolder" />
                                        <Button Content="Remove Folder" AccessKey="R"
                                                ToolTipService.ToolTip="Remove this folder from the list entirely. To skip it temporarily, untick it instead."
                                                Click="OnRemoveFolder" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Exclusions. Expanded by default: a collapsed Expander
                                 de-realizes its content, so the Add/Remove Exclusion access
                                 keys and focus wouldn't reach the controls inside while
                                 collapsed (collapsing to declutter just sleeps its access
                                 keys until reopened). Presets cover the common cases with no
                                 wildcard typing; anything else goes through the Add Exclusion
                                 builder dialog into the custom list (checkbox rows, same
                                 screen-reader idiom as the folder list). Tooltips carry each
                                 preset's patterns. -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="True" Header="Exclusions">
                                <StackPanel Spacing="6">
                                    <!-- The automation name promotes this panel to a named UIA
                                         group, so a screen reader announces "Exclude from backup"
                                         once when focus enters the checkboxes and stays quiet
                                         while moving inside. -->
                                    <StackPanel AutomationProperties.Name="Exclude from backup">
                                        <CheckBox x:Name="ChkExTemp"
                                                  Content="Temporary files (*.tmp, *.bak, ~$* lock files)"
                                                  ToolTipService.ToolTip="Skips *.tmp and *.bak files and Office lock files (~$*) everywhere."
                                                  Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                        <CheckBox x:Name="ChkExSystem"
                                                  Content="System clutter (Thumbs.db, desktop.ini, .DS_Store, $RECYCLE.BIN, System Volume Information)"
                                                  ToolTipService.ToolTip="Skips Thumbs.db, desktop.ini and .DS_Store files, and the $RECYCLE.BIN and System Volume Information folders."
                                                  Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                        <CheckBox x:Name="ChkExDev"
                                                  Content="Developer folders (node_modules, .git, bin, obj, .vs)"
                                                  ToolTipService.ToolTip="Skips folders with these names wherever they appear."
                                                  Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                        <CheckBox x:Name="ChkExCache"
                                                  Content="Caches and disc images (cache and .cache folders, *.iso, *.img)"
                                                  ToolTipService.ToolTip="Skips folders named cache or .cache wherever they appear, and *.iso and *.img files."
                                                  Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                    </StackPanel>
                                    <TextBlock Text="Custom exclusions:" Margin="0,4,0,0" />
                                    <!-- A plain single-select ListView, unlike the checkbox-row
                                         lists elsewhere: these entries carry no per-row state to
                                         announce (Add/Remove is the whole interaction), so the
                                         native list idiom - one tab stop, arrows move selection,
                                         "x of y" position reporting - is the clearer fit. -->
                                    <Border BorderThickness="1" Height="92" CornerRadius="4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <ListView x:Name="ExcludeList" ItemsSource="{x:Bind Excludes}"
                                                  AutomationProperties.Name="Custom exclusions"
                                                  SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ExcludeItem">
                                                    <TextBlock Text="{x:Bind Caption}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add Exclusion..." AccessKey="U"
                                                Click="OnAddExclude" />
                                        <Button Content="Remove Exclusion" AccessKey="X"
                                                ToolTipService.ToolTip="Remove the selected exclusion from the list"
                                                Click="OnRemoveExclude" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- How to back up: Mode and Versioning side by side, since both
                                 answer "how" and pairing them halves this vertical run. -->
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Mode. RadioButtons (the container) gives arrow-key
                                         selection-follows-focus and a single tab stop. The
                                         short word is the visible label; the description sits
                                         on a second line, both inside the radio's content. -->
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Mode" Style="{StaticResource CardTitle}" />
                                        <!-- The two-line content (bold word + caption) stops the
                                             RadioButton deriving a UIA name from its text, so each
                                             carries an explicit Name that is the verbatim visible text
                                             (the accessible name still matches what is shown). -->
                                        <RadioButtons AutomationProperties.Name="Mode">
                                            <RadioButton x:Name="RbAdditive" IsChecked="True" AccessKey="I"
                                                         Checked="OnDirtyChecked"
                                                         AccessKeyInvoked="OnToggleAccessKeyInvoked"
                                                         AutomationProperties.Name="Additive. Copy new and changed files; nothing at the destination is ever deleted.">
                                                <StackPanel>
                                                    <TextBlock Text="Additive" />
                                                    <TextBlock Text="Copy new and changed files; nothing at the destination is ever deleted."
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RbMirror" AccessKey="M"
                                                         Checked="OnDirtyChecked"
                                                         AccessKeyInvoked="OnToggleAccessKeyInvoked"
                                                         AutomationProperties.Name="Mirror. Make the destination match the source exactly; files deleted from the source are also deleted at the destination.">
                                                <StackPanel>
                                                    <TextBlock Text="Mirror" />
                                                    <TextBlock Text="Make the destination match the source exactly; files deleted from the source are also deleted at the destination."
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </RadioButtons>
                                    </StackPanel>

                                    <!-- Versioning. The keep-count NumberBox greys out while the
                                         box is off, mirroring the schedule pattern. A small left
                                         margin nudges the group clear of the Mode column. -->
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                        <TextBlock Text="Versioning" Style="{StaticResource CardTitle}" />
                                        <CheckBox x:Name="ChkVersioned" Content="Keep dated backup versions" IsChecked="False" AccessKey="V"
                                                  ToolTipService.ToolTip="Each run copies into a dated folder (like 2026-06-10) inside the destination, and the oldest dated folders beyond the keep count are removed after a successful run."
                                                  Checked="OnVersionedChanged" Unchecked="OnVersionedChanged"
                                                  AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="Versions to keep:" VerticalAlignment="Center" />
                                            <NumberBox x:Name="NumVersionsKeep" VerticalAlignment="Center"
                                                       AutomationProperties.Name="Versions to keep"
                                                       Minimum="1" Maximum="365" Value="5" SmallChange="1"
                                                       SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" MinWidth="100"
                                                       ValueChanged="OnVersionsKeepChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Schedule. Expanded by default: a collapsed Expander de-realizes
                                 its content, so Alt+Y / Alt+W and focus wouldn't reach the
                                 schedule controls while collapsed. Save Settings is the single
                                 source of truth: ticking "Run a scheduled backup" and saving
                                 registers the task, unticking and saving removes it. The
                                 day/time controls grey out while that box is off. -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="True" Header="Schedule">
                                <StackPanel Spacing="6">
                                    <CheckBox x:Name="ChkSchedule" Content="Run a scheduled backup" IsChecked="False" AccessKey="Y"
                                              Checked="OnScheduleEnabledChanged" Unchecked="OnScheduleEnabledChanged"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    <StackPanel x:Name="ScheduleConfig">
                                        <!-- Day picker: all seven ticked = daily, one = weekly, any
                                             mix = custom. Seven real CheckBoxes (one accessible name
                                             each) instead of a frequency mode, matching the lists'
                                             screen-reader idiom. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="On:" VerticalAlignment="Center" />
                                            <StackPanel x:Name="DayGroup" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                                        AutomationProperties.Name="Backup days">
                                                <StackPanel.Resources>
                                                    <!-- The default CheckBox style reserves ~120px MinWidth, which
                                                         spaced the seven days into wide uniform columns that ran off
                                                         the window. Shrink to content width so Spacing is the only gap. -->
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="MinWidth" Value="0" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <CheckBox x:Name="ChkMon" Content="Monday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkTue" Content="Tuesday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkWed" Content="Wednesday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkThu" Content="Thursday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkFri" Content="Friday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkSat" Content="Saturday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                                <CheckBox x:Name="ChkSun" Content="Sunday" Checked="OnDirtyChecked" Unchecked="OnDirtyChecked" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="at" VerticalAlignment="Center" />
                                            <TimePicker x:Name="TimeSchedule" VerticalAlignment="Center"
                                                        MinuteIncrement="1"
                                                        AutomationProperties.Name="Backup run time"
                                                        SelectedTimeChanged="OnScheduleTimeChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Deliberately outside ScheduleConfig: this is its own
                                         trigger (a second scheduled task), usable with or
                                         without the day/time schedule, so it must not grey
                                         out when "Run a scheduled backup" is off. -->
                                    <CheckBox x:Name="ChkOnConnect" AccessKey="W" Margin="0,4,0,0"
                                              Content="Automatically run when the backup destination becomes available (checks every 15 min)"
                                              ToolTipService.ToolTip="Adds a second scheduled task that quietly checks for the destination every 15 minutes and at sign-in, and runs the backup at most once per day when it is reachable. Works for external drives and network shares, with or without the day/time schedule."
                                              Checked="OnDirtyChecked" Unchecked="OnDirtyChecked"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    <TextBlock x:Name="LblNextRun" Text="Next run: (unknown)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>

                            <!-- Output details. Collapsed by default, and safe to collapse: it
                                 holds no access-keyed or actionable controls (just the progress
                                 bar and the read-only output), unlike Exclusions and Schedule
                                 above. The run summary and live progress are mirrored into the
                                 always-visible status bar, and completion is announced there (a
                                 collapsed Expander de-realizes its content, so a notification
                                 raised on a control inside would be dropped). -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Header="Output details">
                                <StackPanel Spacing="2">
                                    <!-- Not a live region: the end-of-run summary and the
                                         cancellation message are spoken via a UIA notification
                                         (AnnounceNotification), which carries its text in the
                                         event and is more reliable for one-shot messages. -->
                                    <!-- No AutomationProperties.Name: a static name overrides the
                                         live text as the UIA Name, so a screen reader's review cursor
                                         reads the label ("Backup progress") instead of the current
                                         step. Let the running text be the accessible name. -->
                                    <TextBlock x:Name="FileProgressLabel" Margin="0,0,0,2" />
                                    <ProgressBar x:Name="FileProgress" Minimum="0" Maximum="1" Value="0"
                                                 AutomationProperties.Name="Backup progress bar" />
                                    <TextBlock Text="Output:" Margin="0,8,0,2" />
                                    <TextBox x:Name="TxtOutput" Height="150" IsReadOnly="True" IsSpellCheckEnabled="False"
                                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Backup output" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned action bar: Save / Run stay reachable without scrolling.
                         A separator splits the primary cluster (Save accent, Run, Preview,
                         Stop) from the secondary openers. -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnSave" Content="Save Settings" AccessKey="S" Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Save settings and regenerate the backup script and scheduled task"
                                    Click="OnSave" />
                            <Button x:Name="BtnRunNow" Content="Run Now" AccessKey="N"
                                    ToolTipService.ToolTip="Run the backup now"
                                    Click="OnRunNow" />
                            <Button x:Name="BtnPreview" Content="Preview" AccessKey="P"
                                    ToolTipService.ToolTip="Preview the backup without making changes"
                                    Click="OnPreview" />
                            <!-- Always present, enabled only while a backup runs: a button that
                                 pops into existence is not discoverable with a screen reader,
                                 whereas a disabled button is announced as unavailable in its
                                 stable place. -->
                            <Button x:Name="BtnStopBackup" Content="Stop Backup" AccessKey="T" IsEnabled="False"
                                    ToolTipService.ToolTip="Stop the running backup"
                                    Click="OnStopBackup" />
                            <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button Content="Open Last Log" AccessKey="L"
                                    ToolTipService.ToolTip="Open the last backup log"
                                    Click="OnOpenLog" />
                            <Button Content="Open Destination" AccessKey="O"
                                    ToolTipService.ToolTip="Open the backup destination folder"
                                    Click="OnOpenDest" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ SYSTEM IMAGE ============================ -->
                <Grid x:Name="SystemImagePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Stretch" Margin="16" Spacing="12">

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Create a full image of this PC (Windows, programs, settings and all) using the built-in Windows backup engine, so the whole machine can be restored after a disk failure. Restoring is done by booting from Windows installation media; use Create Recovery Media below to build a bootable USB, and Restore Instructions for the steps." />

                            <!-- Destination -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Image destination" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtImageTarget" Grid.Column="0"
                                                 AutomationProperties.Name="Image destination"
                                                 PlaceholderText="Choose a drive or share to store images..."
                                                 AccessKey="D"
                                                 TextChanged="OnImageDirtyChanged" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Bottom" Margin="8,0,0,0">
                                            <Button Content="Browse..." AccessKey="B"
                                                    Click="OnBrowseImageTarget" />
                                            <Button Content="Test"
                                                    ToolTipService.ToolTip="Test the image destination"
                                                    Click="OnTestImageTarget" />
                                            <!-- Lives beside the destination it queries, not on the
                                                 action bar - the bar already runs the window's full
                                                 width and an eighth button clipped off the right edge. -->
                                            <Button x:Name="BtnViewImages" Content="List Images" AccessKey="V"
                                                    ToolTipService.ToolTip="List the system images already on this destination (needs Administrator approval)"
                                                    Click="OnViewExistingImages" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- The destination kind is derived from the path, not chosen
                                         separately, so the two can never disagree: a UNC path is a
                                         network share, anything else a local/external disk. Both
                                         captions are AccessibilityView=Raw: the same wording is set
                                         as the destination field's HelpText (spoken on focus), so a
                                         screen reader hears the current kind when it lands on the
                                         field rather than reading these as orphan paragraphs. -->
                                    <TextBlock Text="A local or external disk (like E:\) keeps several past images automatically and is the most reliable to restore from. A network share (like \\server\share) keeps only the most recent image."
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="LblImageTargetKind" TextWrapping="Wrap"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </Border>

                            <!-- Schedule. Expanded by default for the same reason as the File
                                 Backup schedule: a collapsed Expander de-realizes its content,
                                 sleeping the access keys and focus of the controls inside. -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="True" Header="Schedule">
                                <StackPanel Spacing="6">
                                    <CheckBox x:Name="ChkImageSchedule" Content="Create images on a schedule" IsChecked="False" AccessKey="Y"
                                              ToolTipService.ToolTip="Registers a scheduled task that runs as SYSTEM with the highest privileges, so it needs no approval prompt at run time. Registering or changing it asks for Administrator approval once."
                                              Checked="OnImageScheduleEnabledChanged" Unchecked="OnImageScheduleEnabledChanged"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    <StackPanel x:Name="ImageScheduleConfig">
                                        <!-- Frequency: one of weekly / monthly / daily. Single-word
                                             content, so each radio's accessible name derives from its
                                             text with no explicit Name needed. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="How often:" VerticalAlignment="Center" />
                                            <RadioButtons x:Name="ImageCadenceRadios" AutomationProperties.Name="How often"
                                                          MaxColumns="3">
                                                <RadioButton x:Name="RbImageWeekly" Content="Weekly" IsChecked="True"
                                                             Checked="OnImageCadenceChanged" />
                                                <RadioButton x:Name="RbImageMonthly" Content="Monthly"
                                                             Checked="OnImageCadenceChanged" />
                                                <RadioButton x:Name="RbImageDaily" Content="Daily"
                                                             Checked="OnImageCadenceChanged" />
                                            </RadioButtons>
                                        </StackPanel>
                                        <!-- Day and time share one row: the cadence-specific day
                                             control (weekly combo or monthly day, toggled) sits left
                                             of "at [time]", which uses the empty space on the line.
                                             On Daily both day controls collapse, leaving just the time. -->
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <StackPanel x:Name="ImageWeeklyDayRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="On:" VerticalAlignment="Center" />
                                                <ComboBox x:Name="CmbImageWeeklyDay" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Day of week"
                                                          SelectionChanged="OnImageDirtySelection">
                                                    <ComboBoxItem Content="Monday" />
                                                    <ComboBoxItem Content="Tuesday" />
                                                    <ComboBoxItem Content="Wednesday" />
                                                    <ComboBoxItem Content="Thursday" />
                                                    <ComboBoxItem Content="Friday" />
                                                    <ComboBoxItem Content="Saturday" />
                                                    <ComboBoxItem Content="Sunday" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="ImageMonthlyDayRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <TextBlock Text="On day:" VerticalAlignment="Center" />
                                                <NumberBox x:Name="NumImageMonthlyDay" VerticalAlignment="Center"
                                                           AutomationProperties.Name="Day of month"
                                                           Minimum="1" Maximum="28" Value="1" SmallChange="1"
                                                           SpinButtonPlacementMode="Compact" MinWidth="100"
                                                           ValueChanged="OnImageMonthlyDayChanged" />
                                                <TextBlock Text="(1 to 28)" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="at" VerticalAlignment="Center" />
                                                <TimePicker x:Name="TimeImage" VerticalAlignment="Center"
                                                            MinuteIncrement="1"
                                                            AutomationProperties.Name="System image run time"
                                                            SelectedTimeChanged="OnImageTimeChanged" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="LblImageNextRun" Text="Next run: (unknown)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>

                            <!-- BitLocker reminder. Always-correct static note (no per-run probe),
                                 so it reads as an informative paragraph, not field help. -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="If this PC uses BitLocker drive encryption, keep your BitLocker recovery key safe: a restored image is unencrypted until you turn BitLocker back on." />

                            <!-- Output details. Collapsed and safe to collapse: it holds no
                                 access-keyed controls, and live progress plus the completion
                                 announcement are mirrored into the always-visible status bar. -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Header="Output details">
                                <StackPanel Spacing="2">
                                    <!-- No AutomationProperties.Name; see FileProgressLabel: the live
                                         text is the accessible name so the review cursor reads it. -->
                                    <TextBlock x:Name="ImageProgressLabel" Margin="0,0,0,2" />
                                    <ProgressBar x:Name="ImageProgress" Minimum="0" Maximum="100" Value="0"
                                                 AutomationProperties.Name="System image progress bar" />
                                    <TextBlock Text="Output:" Margin="0,8,0,2" />
                                    <TextBox x:Name="TxtImageOutput" Height="150" IsReadOnly="True" IsSpellCheckEnabled="False"
                                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="System image output" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned action bar. Save is primary; a separator splits it from the
                         recovery-media, restore-help and log openers. Stop Image is always
                         present, enabled only while an image runs (same discoverability
                         reasoning as Stop Backup). -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnSaveImage" Content="Save Settings" AccessKey="S" Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Save settings, regenerate the image script and apply the schedule"
                                    Click="OnSaveImage" />
                            <Button x:Name="BtnCreateImage" Content="Create Image Now" AccessKey="N"
                                    ToolTipService.ToolTip="Create a full system image now (needs Administrator approval)"
                                    Click="OnCreateImageNow" />
                            <Button x:Name="BtnStopImage" Content="Stop Image" AccessKey="T" IsEnabled="False"
                                    ToolTipService.ToolTip="Stop the running system image (needs Administrator approval)"
                                    Click="OnStopImage" />
                            <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button x:Name="BtnRecoveryMedia" Content="Create Recovery Media..." AccessKey="M"
                                    ToolTipService.ToolTip="Build a bootable Windows installation USB to restore an image from"
                                    Click="OnCreateRecoveryMedia" />
                            <Button Content="Restore Instructions" AccessKey="R"
                                    ToolTipService.ToolTip="Show how to restore this PC from a system image"
                                    Click="OnRestoreHelp" />
                            <Button Content="Open Last Log" AccessKey="L"
                                    ToolTipService.ToolTip="Open the last system image log"
                                    Click="OnOpenImageLog" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ APP MANAGEMENT ============================ -->
                <Grid x:Name="AppMgmtPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- Content fills the window width (see the File Backup page). -->
                        <StackPanel HorizontalAlignment="Stretch" Margin="16" Spacing="12">

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Apps installed on this PC. Tick the ones to keep and press Export to save the list; tick &quot;Also export app settings&quot; first to copy their settings folders too. On a new PC, use Import List to reinstall from a saved list." />

                            <!-- Export destination -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="List destination" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtAppDest" Grid.Column="0"
                                                 AutomationProperties.Name="List destination"
                                                 PlaceholderText="Choose where the app list is saved..."
                                                 AccessKey="D" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Bottom" Margin="8,0,0,0">
                                            <Button Content="Browse..." AccessKey="B"
                                                    Click="OnBrowseApp" />
                                            <Button Content="Test"
                                                    ToolTipService.ToolTip="Test the app list destination"
                                                    Click="OnTestApp" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Installed apps -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Installed apps" Style="{StaticResource CardTitle}" />
                                    <!-- Toolbar -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="BtnAppRefresh" Content="Refresh List" AccessKey="R"
                                                ToolTipService.ToolTip="Rescan installed apps"
                                                Click="OnRefreshApps" />
                                        <Button x:Name="BtnAppAll" Content="Select All" AccessKey="L"
                                                ToolTipService.ToolTip="Tick all visible apps"
                                                Click="OnSelectAll" />
                                        <Button x:Name="BtnAppNone" Content="Select None" AccessKey="N"
                                                ToolTipService.ToolTip="Untick all visible apps"
                                                Click="OnSelectNone" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAppFilter" Text="Filter:" VerticalAlignment="Center" />
                                            <TextBox x:Name="TxtAppFilter" Width="240" AccessKey="F" VerticalAlignment="Center"
                                                     AutomationProperties.LabeledBy="{x:Bind LblAppFilter}"
                                                     PlaceholderText="Name, publisher or type..."
                                                     ToolTipService.ToolTip="Filter by name, publisher, app type (winget / store / manual) or package ID"
                                                     TextChanged="OnFilterChanged" />
                                        </StackPanel>
                                        <!-- Results count. Its visible text is its accessible name; it
                                             only announces while the filter box has focus (see
                                             UpdateAppCount) so scans and imports are not double-spoken. -->
                                        <TextBlock x:Name="LblAppCount" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>

                                    <!-- App list. Application is a star column so it grows
                                         with the window; Version and Source stay fixed. The
                                         header and row grids share these widths to stay aligned. -->
                                    <Grid Margin="32,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="560" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Application" Style="{StaticResource ColumnHeader}" />
                                        <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource ColumnHeader}" />
                                        <TextBlock Grid.Column="2" Text="Source" Style="{StaticResource ColumnHeader}" />
                                    </Grid>
                                    <Border BorderThickness="1" Height="280" CornerRadius="4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="AppListControl" ItemsSource="{x:Bind AppRows}"
                                                          AutomationProperties.Name="Installed applications"
                                                          TabFocusNavigation="Once"
                                                          XYFocusKeyboardNavigation="Enabled">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AppEntry">
                                                        <CheckBox Margin="3,2" HorizontalAlignment="Stretch"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  IsChecked="{x:Bind Include, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{x:Bind Caption}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MaxWidth="560" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="130" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Version}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind SourceLabel}"
                                                                           Margin="0,0,8,0" />
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- One Export action covers the list and (optionally) the apps'
                                         settings folders; the checkbox sits with the list so the option
                                         is read before the Export button in the bar below. -->
                                    <CheckBox x:Name="ChkExportSettings" Margin="0,6,0,0" AccessKey="A"
                                              Content="Also export app settings"
                                              ToolTipService.ToolTip="When ticked, Export also finds the ticked apps' settings folders and copies them alongside the app list, after you confirm the matches"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />

                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Note: Reinstalling may require Administrator rights. If installs fail with an access error, restart GUARD as Administrator. Portable apps (run from a folder, no installer) are not auto-detected." />
                                </StackPanel>
                            </Border>

                            <!-- Output details. Hidden by default, like the File Backup page;
                                 Update All Apps opens it on start (the winget stream is that
                                 job's only progress, so a collapsed console left it invisible). -->
                            <Expander x:Name="AppOutputExpander"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Header="Output details">
                                <StackPanel Spacing="2">
                                    <!-- No AutomationProperties.Name; see FileProgressLabel: the live
                                         text is the accessible name so the review cursor reads it. -->
                                    <TextBlock x:Name="AppProgressLabel" Margin="0,0,0,2" />
                                    <ProgressBar x:Name="AppProgress" Minimum="0" Maximum="1" Value="0"
                                                 AutomationProperties.Name="Reinstall progress bar" />
                                    <TextBlock Text="Output:" Margin="0,8,0,2" />
                                    <TextBox x:Name="TxtAppOutput" Height="120" IsReadOnly="True" IsSpellCheckEnabled="False"
                                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Inventory output" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned action bar. Export is the primary action; a separator
                         splits it from the secondary openers. Reinstall is launched from
                         the Import List dialog (it acts on the saved list), so the only
                         reinstall control here is Stop. -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnAppExport" Content="Export" AccessKey="E" Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Export the ticked apps to the destination as a JSON list, plus their settings folders when the option above is ticked"
                                    Click="OnExportApps" />
                            <Button x:Name="BtnAppImport" Content="Import List" AccessKey="I"
                                    ToolTipService.ToolTip="Open a saved app list to reinstall its apps (and optionally restore their settings)"
                                    Click="OnImportApps" />
                            <Button x:Name="BtnAppUpdateAll" Content="Update All Apps" AccessKey="U"
                                    ToolTipService.ToolTip="Ask winget to update every app it knows to the latest version"
                                    Click="OnUpdateAllApps" />
                            <!-- Enabled only while a reinstall or update-all runs; its label
                                 tracks which job it would stop (accessible name = visible
                                 label). Same discoverability reasoning as Stop Backup. -->
                            <Button x:Name="BtnAppStop" Content="Stop Reinstall" AccessKey="T" IsEnabled="False"
                                    ToolTipService.ToolTip="Stop the running job; apps already installed or updated stay that way"
                                    Click="OnStopReinstall" />
                            <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button Content="Open Folder" AccessKey="O"
                                    ToolTipService.ToolTip="Open the app list destination folder"
                                    Click="OnOpenAppDest" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ SETTINGS ============================ -->
                <!-- Reached through the NavigationView's built-in Settings footer item
                     (IsSettingsVisible); standard gear icon with standard UIA semantics.
                     Everything here saves to guard-prefs.ini the moment it changes, so
                     there is no bottom action bar (nothing to Save; the status bar says
                     so while this page is focused). -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Stretch" Margin="16" Spacing="12">

                            <!-- Updates -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                                    <CheckBox x:Name="ChkUpdateAutoCheck" AccessKey="U"
                                              Content="Check for updates automatically"
                                              ToolTipService.ToolTip="Once a day when GUARD starts, quietly check GitHub for a newer release and mention it here if one exists"
                                              Checked="OnUpdatePrefChanged" Unchecked="OnUpdatePrefChanged"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    <!-- Indented + greyed while auto-check is off, mirroring the
                                         schedule sections' dependent-control pattern. -->
                                    <CheckBox x:Name="ChkUpdateAutoInstall" AccessKey="A" Margin="24,0,0,0"
                                              Content="Download updates automatically and install them when GUARD exits"
                                              ToolTipService.ToolTip="When a check finds a new version, download it in the background and apply it after you close GUARD, instead of asking first"
                                              Checked="OnUpdatePrefChanged" Unchecked="OnUpdatePrefChanged"
                                              AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    <Button x:Name="BtnCheckUpdates" Content="Check for Updates Now" AccessKey="C"
                                            Margin="0,4,0,0"
                                            ToolTipService.ToolTip="Check GitHub for a newer GUARD release right now; a skipped version is offered again"
                                            Click="OnCheckUpdatesNow" />
                                </StackPanel>
                            </Border>

                            <!-- Appearance -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                                    <!-- Single-word contents, so each radio derives its own UIA
                                         name from its text (unlike the Mode radios' two-line
                                         content); only the group needs an explicit Name. -->
                                    <RadioButtons AutomationProperties.Name="Appearance" MaxColumns="3">
                                        <RadioButton x:Name="RbThemeSystem" Content="System setting" IsChecked="True"
                                                     Checked="OnThemeChanged" />
                                        <RadioButton x:Name="RbThemeLight" Content="Light"
                                                     Checked="OnThemeChanged" />
                                        <RadioButton x:Name="RbThemeDark" Content="Dark"
                                                     Checked="OnThemeChanged" />
                                    </RadioButtons>
                                    <TextBlock Text="System setting follows Windows' light or dark mode; Light or Dark pins GUARD to one."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Startup -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Startup" Style="{StaticResource CardTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Page shown when GUARD opens:" VerticalAlignment="Center" />
                                        <!-- Items are built from the NavigationView's own menu items
                                             (PopulateStartupCombo), so a future page appears here with
                                             no extra work. -->
                                        <ComboBox x:Name="CmbStartupPage" AccessKey="P" MinWidth="200"
                                                  AutomationProperties.Name="Page shown when GUARD opens"
                                                  SelectionChanged="OnStartupPageChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Notifications: outcomes of UNATTENDED backup runs only (the
                                 scheduled task and the on-connect check). Runs started inside
                                 GUARD announce through the screen reader instead, and the
                                 scheduled system image runs as SYSTEM in session 0, which
                                 cannot reach the desktop with a toast - its outcome surfaces
                                 in the System Image status line at launch. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Notifications" Style="{StaticResource CardTitle}" />
                                    <!-- Raw + group Name (the exclusions-list pattern): the intro is
                                         the group's accessible name, so a screen reader speaks it once
                                         when focus enters the checkboxes and stays quiet while moving
                                         between them, instead of it being an orphan paragraph. -->
                                    <TextBlock TextWrapping="Wrap"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Show a Windows notification when a scheduled or on-connect backup finishes:" />
                                    <StackPanel Spacing="6"
                                                AutomationProperties.Name="Show a Windows notification when a scheduled or on-connect backup finishes">
                                        <CheckBox x:Name="ChkNotifyFailure" AccessKey="F"
                                                  Content="When it fails or cannot run"
                                                  ToolTipService.ToolTip="Notify when an unattended backup finishes with errors, or a scheduled backup cannot reach its destination"
                                                  Checked="OnNotifyPrefChanged" Unchecked="OnNotifyPrefChanged"
                                                  AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                        <CheckBox x:Name="ChkNotifySuccess" AccessKey="G"
                                                  Content="When it succeeds"
                                                  ToolTipService.ToolTip="Also notify when an unattended backup finishes cleanly; off by default so a working nightly backup stays quiet"
                                                  Checked="OnNotifyPrefChanged" Unchecked="OnNotifyPrefChanged"
                                                  AccessKeyInvoked="OnToggleAccessKeyInvoked" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="These cover backups run by the schedule or the on-connect check, not ones you start inside GUARD. The first notification registers GUARD's name with Windows (a one-time entry for your user account)." />
                                </StackPanel>
                            </Border>

                            <!-- Scheduled tasks: the removal exit. GUARD's tasks are
                                 registered with Windows, not stored in GUARD's folder,
                                 so deleting the app (or uninstalling it via winget)
                                 leaves them behind firing at an exe that is gone. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Scheduled tasks" Style="{StaticResource CardTitle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="GUARD's schedules are registered with Windows Task Scheduler, not kept in GUARD's folder. If you plan to delete or uninstall GUARD, remove them first, or they stay behind trying to run an app that is no longer there." />
                                    <Button x:Name="BtnRemoveTasks" Content="Remove GUARD's Scheduled Tasks" AccessKey="T"
                                            Margin="0,4,0,0"
                                            ToolTipService.ToolTip="Unregister the scheduled backup, the on-connect check and the scheduled system image; your settings and existing backups are not touched"
                                            Click="OnRemoveScheduledTasks" />
                                </StackPanel>
                            </Border>

                            <!-- winget: shown only while winget is missing (lazy
                                 probe on the page's first visit, like the wbadmin
                                 check; ProbeWingetForSettings). A successful
                                 install hides the card. -->
                            <Border x:Name="CardWinget" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="App reinstalls" Style="{StaticResource CardTitle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="winget, Windows' app package manager, is not installed on this PC. App Management needs it to reinstall apps from a saved list automatically; exporting lists works without it." />
                                    <Button x:Name="BtnInstallWinget" Content="Install winget" AccessKey="W"
                                            Margin="0,4,0,0"
                                            ToolTipService.ToolTip="Download Microsoft's App Installer package and set winget up for your user account; no Administrator approval is needed"
                                            Click="OnWingetOfferInvoked" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Update notice: non-modal by design. The launch auto-check must not
             steal focus with a dialog while the user is orienting, so it lands
             here (above the status bar, where announcements already point) with
             a button into the full update dialog; closing it means "remind me
             later". Announced once via the status bar's UIA notification. -->
        <StackPanel Grid.Row="1">
            <InfoBar x:Name="UpdateInfoBar" Margin="12,4" IsOpen="False"
                     Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="BtnUpdateDetails" Content="View Update"
                            ToolTipService.ToolTip="See what's new and choose whether to install (Ctrl+U)"
                            Click="OnUpdateInfoBarAction">
                        <Button.KeyboardAccelerators>
                            <!-- Window-wide jump into the offer: the InfoBar sits at
                                 the end of the tab order, so a keyboard user would
                                 otherwise Tab through the whole page to reach it.
                                 Inert while the InfoBar is closed (a collapsed
                                 element's accelerator does not fire). -->
                            <KeyboardAccelerator Modifiers="Control" Key="U" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- winget offer: same non-modal shape as the update notice. Opened
                 when an app scan finds winget missing (ShowWingetOffer); the scan
                 summary is the spoken cue (with the Ctrl+I hint appended to the
                 speech only), so opening it adds no announcement. Ctrl+I, not an
                 Alt AccessKey: the InfoBar overlays every page, so a mnemonic
                 would need to be unique across all of them (the View Update
                 reasoning); the accelerator is inert while the bar is closed. -->
            <InfoBar x:Name="WingetInfoBar" Margin="12,4" IsOpen="False"
                     Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="BtnWingetInfoBar" Content="Install winget"
                            ToolTipService.ToolTip="Download Microsoft's App Installer package and set winget up for your user account (Ctrl+I)"
                            Click="OnWingetOfferInvoked">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Status bar. Shows the FOCUSED page's status (settings state on File
             Backup, scan/import summary on App Management) on the left and that
             page's job progress on the right; both repaint on a page switch, so the
             bar always reflects the page you are on. A job running on an unfocused
             page stays visible through its nav ring instead.
             StatusBarText is the single live region for status announcements,
             and the bar is the only home of the inventory scan/import summary,
             so each change is announced exactly once. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <!-- StatusBarHost exposes the bar to UIA as control type StatusBar.
                 The background and padding sit on the Grid INSIDE the host, not
                 on the Border: hit-testing resolves to the nearest ancestor with
                 an automation peer, so a hit anywhere on the bar surface must
                 land on content within the host for screen-reader mouse and
                 touch exploration to report the status bar (a Border background
                 would bubble hits past the host to the XAML island root). -->
            <views:StatusBarHost HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid ColumnSpacing="10" Padding="14,6"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Colour reinforces the saved/unsaved state but never carries
                     it alone; the text always says it in words. Hidden on the
                     App Management page, where that semantic does not apply. -->
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         VerticalAlignment="Center" />
                <!-- No AutomationProperties.Name: an explicit name overrides the
                     text as the UIA Name, and a live-region change announces the
                     Name, so a static name would make every announcement read
                     "Status" instead of the message. -->
                <!-- Both status texts trim with an ellipsis when space is tight; a
                     tooltip bound to the text itself surfaces the full message on
                     hover. It mirrors the visible text rather than overriding the
                     accessible name (a screen reader only speaks it if the user opts
                     into reporting tooltips), so the live-region announcement is
                     unaffected. -->
                <TextBlock x:Name="StatusBarText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind StatusBarText.Text, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="StatusBarProgressArea" Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="StatusBarProgressText" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind StatusBarProgressText.Text, Mode=OneWay}" />
                    <ProgressBar x:Name="StatusBarProgress" Width="140" Minimum="0" Maximum="1" Value="0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Running job progress bar" />
                </StackPanel>
            </Grid>
            </views:StatusBarHost>
        </Border>
    </Grid>
</Window>
